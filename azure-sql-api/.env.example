# ==============================================================================
# 1. Azure SQL Database Configuration
# ==============================================================================

# Port ของ REST API Server (ค่าเริ่มต้น 8787)
PORT=8787

# รูปแบบที่ 1: ใช้ Connection String โดยตรงจาก Azure Portal (แนะนำ)
# คัดลอกได้จาก Azure Portal -> SQL Database (shedatabase) -> Settings -> Connection strings -> Node.js
# ตัวอย่าง:
# AZURE_SQL_CONNECTION_STRING=Server=tcp:halls.database.windows.net,1433;Initial Catalog=shedatabase;Persist Security Info=False;User ID=Halls;Password={Hall3030.};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# รูปแบบที่ 2: ระบุแยกทีละค่า
AZURE_SQL_SERVER=halls.database.windows.net
AZURE_SQL_DATABASE=shedatabase
AZURE_SQL_USER=Halls
AZURE_SQL_PASSWORD=Hall3030.
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_CERT=false

# Connection Pool Settings
AZURE_SQL_POOL_MAX=10
AZURE_SQL_POOL_MIN=0


# ==============================================================================
# 2. Azure Blob Storage Configuration (รูปภาพ)
# ==============================================================================

# ชื่อ Container สำหรับเก็บรูปภาพ
AZURE_STORAGE_CONTAINER_NAME=picshesystem

# ชื่อ Storage Account บน Azure Portal (เช่น halls หรือตามที่สร้างไว้)
AZURE_STORAGE_ACCOUNT_NAME=shehalls

# รูปแบบที่ A: ใช้ Connection String ของ Storage Account (แนะนำที่สุด)
# คัดลอกได้จาก Azure Portal -> Storage accounts -> Security + networking -> Access keys -> Connection string
# ตัวอย่าง: DefaultEndpointsProtocol=https;AccountName=halls;AccountKey=xxx...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https:AccountName=shehalls;AccountKey=liuaSll+U4Hzpd63rYERsqibWWRaHDk+m9KzgIHX0Ueni0dKNHfcZ8HHC5i1QHntJL0WnJwMLeYp+AStHSqq3Q==;EndpointSuffix=core.windows.net

# รูปแบบที่ B: ใช้ Account Key
# คัดลอกได้จาก Azure Portal -> Storage accounts -> Access keys -> Key
AZURE_STORAGE_ACCOUNT_KEY=liuaSll+U4Hzpd63rYERsqibWWRaHDk+m9KzgIHX0Ueni0dKNHfcZ8HHC5i1QHntJL0WnJwMLeYp+AStHSqq3Q==

# รูปแบบที่ C: ใช้ SAS Token (หากต้องการกำหนดสิทธิ์จำกัดเวลา)
AZURE_STORAGE_SAS_TOKEN=


# ==============================================================================
# 3. SQLite Migration (สำหรับรันย้ายข้อมูลเก่า)
# ==============================================================================
# ที่อยู่ไฟล์ SQLite เดิม (หากไม่ระบุ ระบบจะค้นหาจาก .wrangler ให้อัตโนมัติ)
SQLITE_DB_PATH=


