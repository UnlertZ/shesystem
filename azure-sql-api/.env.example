# ==============================================================================
# Azure SQL Database Configuration
# ==============================================================================

# Port ของ REST API Server (ค่าเริ่มต้น 8787)
PORT=8787

# รูปแบบที่ 1: ใช้ Connection String โดยตรงจาก Azure Portal (แนะนำ)
# คัดลอกได้จาก Azure Portal -> SQL Database -> Settings -> Connection strings -> Node.js
# ตัวอย่าง:
# AZURE_SQL_CONNECTION_STRING=Server=tcp:yourserver.database.windows.net,1433;Initial Catalog=shesystem;Persist Security Info=False;User ID=cloudadmin;Password=YourPassword123;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
AZURE_SQL_CONNECTION_STRING=

# รูปแบบที่ 2: ระบุแยกทีละค่า (หากไม่ใช้ Connection String ด้านบน)
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_DATABASE=shesystem
AZURE_SQL_USER=cloudadmin
AZURE_SQL_PASSWORD=YourPassword123!
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_CERT=false

# Connection Pool Settings
AZURE_SQL_POOL_MAX=10
AZURE_SQL_POOL_MIN=0

# ที่อยู่ไฟล์ SQLite เดิม (หากต้องการระบุแบบกำหนดเองสำหรับการรัน Migration)
# หากไม่ระบุ ระบบจะค้นหาจาก .wrangler/state/v3/d1/... ให้อัตโนมัติ
SQLITE_DB_PATH=
